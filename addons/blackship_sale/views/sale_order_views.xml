<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_view_blackship_form" model="ir.ui.view">
        <field name="name">sale.order.form.blackship</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@class='oe_button_box']" position="inside">
                <button name="action_blackship_new_revision"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-files-o"
                    string="Crea revisione"
                    attrs="{'invisible': [('is_blackship', '=', False)]}"/>
            </xpath>

            <xpath expr="//group[@name='order_details']" position="inside">
                <group name="blackship_info" attrs="{'invisible': [('is_blackship', '=', False)]}">
                    <field name="is_blackship" readonly="1"/>
                    <field name="quote_version" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Approvals" attrs="{'invisible': [('is_blackship', '=', False)]}">
                    <field name="approval_ids" context="{'default_sale_id': active_id}" create="false">
                        <tree editable="bottom">
                            <field name="requested_by"/>
                            <field name="status"/>
                            <field name="comment"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_blackship_approval_tree" model="ir.ui.view">
        <field name="name">blackship.approval.tree</field>
        <field name="model">blackship.approval</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sale_id"/>
                <field name="requested_by"/>
                <field name="status"/>
                <field name="comment"/>
            </tree>
        </field>
    </record>

    <record id="view_blackship_approval_form" model="ir.ui.view">
        <field name="name">blackship.approval.form</field>
        <field name="model">blackship.approval</field>
        <field name="arch" type="xml">
            <form string="BlackShip Approval">
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        groups="sales_team.group_sale_manager"
                        attrs="{'invisible': [('status', '!=', 'pending')]}"/>
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        class="btn-secondary"
                        groups="sales_team.group_sale_manager"
                        attrs="{'invisible': [('status', '!=', 'pending')]}"/>
                </header>
                <sheet>
                    <group>
                        <field name="sale_id"/>
                        <field name="requested_by"/>
                        <field name="status"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
