<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_lead_form_blackship_checklist" model="ir.ui.view">
        <field name="name">crm.lead.form.blackship.checklist</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="BlackShip" name="blackship">
                    <field name="blackship_checklist_ids" context="{'default_lead_id': active_id}">
                        <tree editable="bottom" default_order="sequence">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="mandatory"/>
                            <field name="is_done"/>
                            <field name="stage_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
