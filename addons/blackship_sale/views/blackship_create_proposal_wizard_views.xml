<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="blackship_create_proposal_wizard_view_form" model="ir.ui.view">
        <field name="name">blackship.create.proposal.wizard.form</field>
        <field name="model">blackship.create.proposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Create BlackShip Proposal">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="partner_id" options="{'no_open': True}" required="1"/>
                    <field name="pricelist_id"/>
                </group>
                <group>
                    <field name="note" widget="html"/>
                </group>
                <footer>
                    <button name="action_create_proposal" type="object" string="Create Proposal" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_blackship_create_proposal_wizard" model="ir.actions.act_window">
        <field name="name">Create BlackShip Proposal</field>
        <field name="res_model">blackship.create.proposal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="blackship_create_proposal_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'default_lead_id': active_id, 'default_partner_id': partner_id}</field>
    </record>

    <record id="view_crm_lead_form_blackship_proposal_button" model="ir.ui.view">
        <field name="name">crm.lead.form.blackship.proposal.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(action_blackship_create_proposal_wizard)d"
                    type="action"
                    string="Create BlackShip Proposal"
                    class="oe_highlight"
                    attrs="{'invisible': [('active', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
