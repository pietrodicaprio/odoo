<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_blackship_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.blackship.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sale_default_commitment_date']" position="after">
                <setting string="BlackShip" help="BlackShip approval settings">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="blackship_discount_threshold"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="blackship_discount_threshold" string="Discount approval threshold"/>
                                <div class="text-muted">
                                    Specify the maximum allowed discount percentage on BlackShip orders before approval is required.
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
